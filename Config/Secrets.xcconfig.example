// Default API base URL (committed). Copy to `Secrets.xcconfig` only if you customize per machine.
// To keep local URLs private, add `Config/Secrets.xcconfig` to .gitignore (see root .gitignore).
//
// Use $(SLASH). bare https:// is truncated at // in xcconfig.
SLASH = /
// Local Worker:  CINESCROLL_API_BASE_URL = http:$(SLASH)/127.0.0.1:8787
CINESCROLL_API_BASE_URL = https:$(SLASH)/cinescroll-api.cinescroll-abdofoda.workers.dev
